# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# 32 random bytes in hex. Keep stable to preserve existing OpenToken API keys.
GATEWAY_SECRET=
# Optional exact app origin. Defaults to accepting 127.0.0.1 on the current port.
APP_ORIGIN=

# Set to 1 for live calls. Set UPSTREAM_MODE explicitly to official or compatible.
ENABLE_OPENAI=
UPSTREAM_MODE=
OPENAI_API_KEY=
# Compatible providers only. USD prices per 1M tokens.
COMPATIBLE_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_RESPONSE_MODEL=
UPSTREAM_INPUT_USD_PER_MTOK=
UPSTREAM_CACHED_USD_PER_MTOK=
UPSTREAM_OUTPUT_USD_PER_MTOK=
UPSTREAM_MAX_CONTEXT_TOKENS=
UPSTREAM_MAX_TOKENS_FIELD=
ENABLE_UPSTREAM_STREAMING=0
# See replica/stage7.md for approved pilot model configuration.
UPSTREAM_PUBLISH_PRIMARY=1
UPSTREAM_ADDITIONAL_MODELS_JSON=
DEMO_DELAY_MS=

# Used by the explicit pilot-credit and one-call verification commands.
PILOT_EMAIL=
PILOT_PASSWORD=
