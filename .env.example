# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# 32 random bytes in hex. Keep stable to preserve existing OpenToken API keys.
GATEWAY_SECRET=
# Optional exact app origin. Defaults to accepting 127.0.0.1 on the current port.
APP_ORIGIN=

# Set to 1 for live calls. Use official or compatible for legacy routes, managed for database-only routing.
ENABLE_OPENAI=
UPSTREAM_MODE=
OPENAI_API_KEY=
# Compatible providers only. USD prices per 1M tokens.
COMPATIBLE_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_RESPONSE_MODEL=
UPSTREAM_INPUT_USD_PER_MTOK=
UPSTREAM_CACHED_USD_PER_MTOK=
UPSTREAM_OUTPUT_USD_PER_MTOK=
UPSTREAM_MAX_CONTEXT_TOKENS=
UPSTREAM_MAX_TOKENS_FIELD=
ENABLE_UPSTREAM_STREAMING=0
# See replica/stage7.md for approved pilot model configuration.
UPSTREAM_PUBLISH_PRIMARY=1
UPSTREAM_ADDITIONAL_MODELS_JSON=

# Stripe test Checkout only. Use a dedicated database with the sandbox marker.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_CREDIT_PRICE_ID=
STRIPE_TEST_CREDIT_20_PRICE_ID=
STRIPE_TEST_CREDIT_50_PRICE_ID=
STRIPE_TEST_SUBSCRIPTION_PRICE_ID=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=

# Stripe live configuration preflight. See replica/stage8.md.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_ENDPOINT_ID=
STRIPE_LIVE_CREDIT_PRICE_ID=
STRIPE_LIVE_CREDIT_20_PRICE_ID=
STRIPE_LIVE_CREDIT_50_PRICE_ID=
STRIPE_LIVE_SUBSCRIPTION_PRICE_ID=
STRIPE_LIVE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVE_PILOT_COUNTRY=
STRIPE_LIVE_TAX_POLICY=
DEMO_DELAY_MS=

# Used by the explicit pilot-credit and one-call verification commands.
PILOT_EMAIL=
PILOT_PASSWORD=

# Admin redeem codes. Both positive USD amounts are required for operator issuance.
OPERATOR_REDEEM_SINGLE_USD=
OPERATOR_REDEEM_DAILY_USD=

# Approved channel references bind a dedicated server env variable to a destination and adapter.
# Example: {"primary":{"type":"compatible","env":"CHANNEL_PRIMARY_KEY","baseUrl":"https://provider.example/v1"}}
CHANNEL_CREDENTIALS_JSON=
