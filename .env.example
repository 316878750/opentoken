# Set to 1 to expose the official model alongside mock-text.
ENABLE_OPENAI=
OPENAI_API_KEY=
DEMO_DELAY_MS=

# Used by the explicit pilot-credit and one-call verification commands.
PILOT_EMAIL=
PILOT_PASSWORD=
