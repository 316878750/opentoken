{
  "name": "opentoken",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.9"},
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/database.mjs seed",
    "db:check": "node --env-file-if-exists=.env.local scripts/database.mjs check",
    "db:review-stale": "node --env-file-if-exists=.env.local scripts/database.mjs review-stale",
    "db:billing": "node --env-file-if-exists=.env.local scripts/database.mjs billing",
    "db:redeem": "node --env-file-if-exists=.env.local scripts/database.mjs redeem",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "db:stripe": "node --env-file-if-exists=.env.local scripts/database.mjs stripe",
    "db:paid-pilot": "node --env-file-if-exists=.env.local scripts/database.mjs paid-pilot",
    "db:admin": "node --env-file-if-exists=.env.local scripts/database.mjs admin",
    "pilot:invite": "node --env-file-if-exists=.env.local scripts/pilot-invite.mjs",
    "verify:live": "node --env-file-if-exists=.env.local scripts/verify-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "23.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
